# name: test/sql/alter/alter_table_sorted_by_schema.test
# description: Test schema changes on tables with SORTED BY history
# group: [alter]

load {TEST_DIR}/alter_table_sorted_by_schema.db readwrite v2.0.0

statement ok
SET checkpoint_threshold = '10 GB'

statement ok
PRAGMA disable_checkpoint_on_shutdown

statement ok
CREATE TABLE sorted_schema(key INTEGER, payload VARCHAR, nested STRUCT(a INTEGER))

statement ok
INSERT INTO sorted_schema VALUES (2, 'bb', {'a': 20}), (1, 'aaa', {'a': 10})

statement ok
ALTER TABLE sorted_schema SET SORTED BY (key)

# A top-level rename preserves the current key identity.
statement ok
ALTER TABLE sorted_schema RENAME COLUMN key TO key2

query I
SELECT contains(sql, 'SORTED BY (key2 ASC NULLS LAST)') FROM duckdb_tables() WHERE table_name = 'sorted_schema'
----
true

statement error
ALTER TABLE sorted_schema DROP COLUMN key2
----
<REGEX>:.*RESET SORTED BY first.*

statement error
ALTER TABLE sorted_schema ALTER key2 SET DATA TYPE BIGINT
----
<REGEX>:.*RESET SORTED BY first.*

# Non-key physical changes are allowed and receive new persistent identities.
statement ok
ALTER TABLE sorted_schema ADD COLUMN extra BIGINT DEFAULT 7

statement ok
ALTER TABLE sorted_schema ALTER payload TYPE BIGINT USING length(payload)

statement ok
ALTER TABLE sorted_schema ADD COLUMN nested.b VARCHAR DEFAULT 'x'

statement ok
ALTER TABLE sorted_schema RENAME COLUMN nested.b TO c

statement ok
ALTER TABLE sorted_schema DROP COLUMN nested.c

statement ok
ALTER TABLE sorted_schema DROP COLUMN payload

restart

query III
SELECT key2, nested, extra FROM sorted_schema ORDER BY key2
----
1	{'a': 10}	7
2	{'a': 20}	7

query I
SELECT contains(sql, 'SORTED BY (key2 ASC NULLS LAST)') FROM duckdb_tables() WHERE table_name = 'sorted_schema'
----
true

# RESET retains history but permits a new physical identity for the former key.
statement ok
ALTER TABLE sorted_schema RESET SORTED BY

statement ok
ALTER TABLE sorted_schema ALTER key2 SET DATA TYPE BIGINT

statement ok
ALTER TABLE sorted_schema SET SORTED BY (key2)

restart

query II
SELECT key2, extra FROM sorted_schema ORDER BY key2
----
1	7
2	7

# FIELD changes rebuild the top-level physical column and are blocked for a current key.
statement ok
CREATE TABLE nested_key(s STRUCT(a INTEGER, b INTEGER), payload INTEGER)

statement ok
ALTER TABLE nested_key SET SORTED BY (s)

statement error
ALTER TABLE nested_key ADD COLUMN s.c INTEGER
----
<REGEX>:.*RESET SORTED BY first.*

statement error
ALTER TABLE nested_key RENAME COLUMN s.a TO c
----
<REGEX>:.*RESET SORTED BY first.*

statement error
ALTER TABLE nested_key DROP COLUMN s.a
----
<REGEX>:.*RESET SORTED BY first.*

statement ok
ALTER TABLE nested_key RESET SORTED BY

statement ok
ALTER TABLE nested_key ADD COLUMN s.c INTEGER
