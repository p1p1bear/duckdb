# name: test/sql/alter/alter_table_set_sorted_by.test
# description: Test ALTER TABLE SET and RESET SORTED BY
# group: [alter]

load {TEST_DIR}/alter_table_set_sorted_by.db readwrite v2.0.0

statement ok
SET checkpoint_threshold = '10 GB'

statement ok
PRAGMA disable_checkpoint_on_shutdown

statement ok
SET default_order = 'DESCENDING'

statement ok
SET default_null_order = 'NULLS_FIRST'

statement ok
CREATE TABLE tbl(i INTEGER, j VARCHAR, g INTEGER GENERATED ALWAYS AS (i + 1))

statement ok
INSERT INTO tbl(i, j) VALUES (2, 'b'), (1, 'a')

# RESET on an ordinary table is a no-op.
statement ok
ALTER TABLE tbl RESET SORTED BY

query T
SELECT sql FROM duckdb_tables() WHERE table_name = 'tbl'
----
CREATE TABLE tbl(i INTEGER, j VARCHAR, g INTEGER GENERATED ALWAYS AS((i + 1)));

statement ok
ALTER TABLE tbl SET SORTED BY (i)

query T
SELECT sql FROM duckdb_tables() WHERE table_name = 'tbl'
----
CREATE TABLE tbl(i INTEGER, j VARCHAR, g INTEGER GENERATED ALWAYS AS((i + 1))) SORTED BY (i ASC NULLS LAST);

# An equivalent SET is a catalog no-op, independent of session defaults.
statement ok
ALTER TABLE tbl SET SORTED BY (i ASC NULLS LAST)

statement ok
ALTER TABLE tbl SET SORTED BY (j)

query T
SELECT sql FROM duckdb_tables() WHERE table_name = 'tbl'
----
CREATE TABLE tbl(i INTEGER, j VARCHAR, g INTEGER GENERATED ALWAYS AS((i + 1))) SORTED BY (j ASC NULLS LAST);

# Recover the complete ALTER post-images from WAL.
restart

query T
SELECT sql FROM duckdb_tables() WHERE table_name = 'tbl'
----
CREATE TABLE tbl(i INTEGER, j VARCHAR, g INTEGER GENERATED ALWAYS AS((i + 1))) SORTED BY (j ASC NULLS LAST);

statement ok
ALTER TABLE tbl RESET SORTED BY

query T
SELECT sql FROM duckdb_tables() WHERE table_name = 'tbl'
----
CREATE TABLE tbl(i INTEGER, j VARCHAR, g INTEGER GENERATED ALWAYS AS((i + 1)));

# Repeated RESET is a no-op and an index is allowed while sorting is disabled.
statement ok
ALTER TABLE tbl RESET SORTED BY

statement ok
CREATE INDEX tbl_i_idx ON tbl(i)

statement error
ALTER TABLE tbl SET SORTED BY (i)
----
<REGEX>:.*SORTED BY tables cannot have indexes.*

statement ok
DROP INDEX tbl_i_idx

# Disabled SORTED BY history can coexist with an index and reload from a checkpoint.
statement ok
CREATE TABLE reset_index_tbl(i INTEGER)

statement ok
ALTER TABLE reset_index_tbl SET SORTED BY (i)

statement ok
ALTER TABLE reset_index_tbl RESET SORTED BY

statement ok
CREATE INDEX reset_index_tbl_i_idx ON reset_index_tbl(i)

# RESET followed by SET creates a fresh current definition.
statement ok
ALTER TABLE tbl SET SORTED BY (i)

statement ok
CHECKPOINT

restart

query T
SELECT sql FROM duckdb_tables() WHERE table_name = 'tbl'
----
CREATE TABLE tbl(i INTEGER, j VARCHAR, g INTEGER GENERATED ALWAYS AS((i + 1))) SORTED BY (i ASC NULLS LAST);

statement ok
INSERT INTO reset_index_tbl VALUES (1)

query I
SELECT * FROM reset_index_tbl
----
1

# An exclusive DDL gate can be reused by later DML and DDL on the same table.
statement ok
BEGIN TRANSACTION

statement ok
ALTER TABLE tbl SET SORTED BY (j)

statement ok
INSERT INTO tbl(i, j) VALUES (3, 'c')

statement ok
ALTER TABLE tbl SET SORTED BY (i)

statement ok
INSERT INTO tbl(i, j) VALUES (4, 'd')

statement ok
ROLLBACK

query I
SELECT count(*) FROM tbl
----
2

# A shared DML gate cannot be upgraded to exclusive DDL in the same transaction.
statement ok
BEGIN TRANSACTION

statement ok
INSERT INTO tbl(i, j) VALUES (3, 'c')

statement error
ALTER TABLE tbl SET SORTED BY (j)
----
<REGEX>:.*cannot acquire an exclusive sorted-table write gate after writing to the table.*

statement ok
ROLLBACK

query T
SELECT sql FROM duckdb_tables() WHERE table_name = 'tbl'
----
CREATE TABLE tbl(i INTEGER, j VARCHAR, g INTEGER GENERATED ALWAYS AS((i + 1))) SORTED BY (i ASC NULLS LAST);

# A rolled-back first SET leaves the table ordinary.
statement ok
CREATE TABLE rollback_tbl(i INTEGER)

statement ok
BEGIN TRANSACTION

statement ok
ALTER TABLE rollback_tbl SET SORTED BY (i)

statement ok
ROLLBACK

statement ok
CREATE OR REPLACE TABLE rollback_tbl(i BIGINT)

query T
SELECT sql FROM duckdb_tables() WHERE table_name = 'rollback_tbl'
----
CREATE TABLE rollback_tbl(i BIGINT);

statement error
ALTER TABLE tbl SET SORTED BY (i DESC)
----
<REGEX>:.*SORTED BY only supports ASC sort order.*

statement error
ALTER TABLE tbl SET SORTED BY (i NULLS FIRST)
----
<REGEX>:.*SORTED BY only supports NULLS LAST.*

statement error
ALTER TABLE tbl SET SORTED BY (i + 1)
----
<REGEX>:.*SORTED BY only supports physical column references.*

statement error
ALTER TABLE tbl SET SORTED BY (tbl.i)
----
<REGEX>:.*SORTED BY only supports unqualified column references.*

statement error
ALTER TABLE tbl SET SORTED BY (missing)
----
<REGEX>:.*SORTED BY column "missing" does not exist.*

statement error
ALTER TABLE tbl SET SORTED BY (i, i)
----
<REGEX>:.*SORTED BY column "i" is specified more than once.*

statement error
ALTER TABLE tbl SET SORTED BY (g)
----
<REGEX>:.*SORTED BY column "g" must be a physical column.*

statement ok
CREATE TABLE constrained(i INTEGER PRIMARY KEY)

statement error
ALTER TABLE constrained SET SORTED BY (i)
----
<REGEX>:.*SORTED BY tables cannot have PRIMARY KEY, UNIQUE, or FOREIGN KEY constraints.*

# A losing concurrent ALTER must not publish its detached storage wrapper.
statement ok
CREATE TABLE concurrent_tbl(i INTEGER, j INTEGER)

statement ok con1
BEGIN TRANSACTION

statement ok con1
ALTER TABLE concurrent_tbl SET SORTED BY (i)

statement ok con2
BEGIN TRANSACTION

statement error con2
ALTER TABLE concurrent_tbl SET SORTED BY (j)
----
<REGEX>:.*Catalog write-write conflict on alter with "concurrent_tbl".*

statement ok con1
ROLLBACK

statement ok con2
ROLLBACK

statement ok
ALTER TABLE concurrent_tbl SET SORTED BY (j)

statement ok
ATTACH ':memory:' AS mem

statement ok
CREATE TABLE mem.memory_tbl(i INTEGER)

statement error
ALTER TABLE mem.memory_tbl SET SORTED BY (i)
----
<REGEX>:.*SORTED BY is only supported for persistent DuckDB tables.*

statement ok
DETACH mem

statement ok
ATTACH '{TEST_DIR}/alter_table_set_sorted_by_old.db' AS old (STORAGE_VERSION 'v1.5.0')

statement ok
CREATE TABLE old.old_tbl(i INTEGER)

statement error
ALTER TABLE old.old_tbl SET SORTED BY (i)
----
<REGEX>:.*SORTED BY requires storage version v2.0.0 or newer.*

statement ok
DETACH old
