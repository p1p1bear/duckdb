# name: test/sql/storage/recluster_run_gaps.test
# description: Recluster sorted runs after checkpoint drops fully deleted row groups
# group: [storage]

statement ok
SET threads=1

statement ok
SET auto_recluster=false

statement ok
SET debug_skip_checkpoint_on_commit=true

statement ok
SET debug_verify_blocks=true

statement ok
PRAGMA disable_checkpoint_on_shutdown

statement ok
ATTACH '{TEST_DIR}/recluster_run_gaps.db' AS r (ROW_GROUP_SIZE 2048, STORAGE_VERSION 'v2.0.0')

statement ok
USE r

foreach mode incremental full

statement ok
CREATE TABLE runs_{mode}(k BIGINT) SORTED BY(k)

statement ok
INSERT INTO runs_{mode} SELECT i*2 FROM range(6144) t(i)

statement ok
INSERT INTO runs_{mode} SELECT i*2+1 FROM range(2048) t(i)

statement ok
CHECKPOINT r

statement ok
DELETE FROM runs_{mode} WHERE k>=4096 AND k<8192

statement ok
CHECKPOINT r

query I
SELECT count(*) FROM (
    SELECT rowid - lag(rowid) OVER (ORDER BY rowid) AS gap FROM runs_{mode}
) WHERE gap>1
----
1

query IT
SELECT tasks_completed, state FROM recluster('r.main.runs_{mode}', mode='{mode}')
----
1	COMPLETE

# The replacement must also replay from WAL with a gapped checkpoint input.
statement ok
USE memory

statement ok
DETACH r

statement ok
ATTACH '{TEST_DIR}/recluster_run_gaps.db' AS r

statement ok
USE r

query III
SELECT count(*), count(DISTINCT k), sum(k) FROM runs_{mode}
----
6144	6144	29356032

query I
SELECT count(*) FROM (
    SELECT k, lag(k) OVER () AS previous FROM runs_{mode}
) WHERE k<previous
----
0

# DELETE cleanup also streams a single run whose physical row IDs have gaps.
statement ok
CREATE TABLE cleanup_{mode}(k BIGINT) SORTED BY(k)

statement ok
INSERT INTO cleanup_{mode} SELECT i FROM range(8192) t(i)

statement ok
CHECKPOINT r

statement ok
DELETE FROM cleanup_{mode} WHERE k>=2048 AND k<4096

statement ok
CHECKPOINT r

statement ok
DELETE FROM cleanup_{mode} WHERE k%2=0

query IT
SELECT tasks_completed, state FROM recluster('r.main.cleanup_{mode}', mode='{mode}')
----
1	COMPLETE

query III
SELECT count(*), count(DISTINCT k), sum(k) FROM cleanup_{mode}
----
3072	3072	13631488

query I
SELECT count(*) FROM (
    SELECT k, lag(k) OVER () AS previous FROM cleanup_{mode}
) WHERE k<previous
----
0

statement ok
CHECKPOINT r

query I
SELECT count(*) FROM cleanup_{mode} WHERE k%2=0 OR (k>=2048 AND k<4096)
----
0

endloop
