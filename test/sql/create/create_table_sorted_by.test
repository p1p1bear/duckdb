# name: test/sql/create/create_table_sorted_by.test
# description: Test persistent DuckDB tables with SORTED BY
# group: [create]

load {TEST_DIR}/create_table_sorted_by.db readwrite v2.0.0

statement ok
SET checkpoint_threshold = '10 GB'

statement ok
PRAGMA disable_checkpoint_on_shutdown

statement ok
SET default_order = 'DESCENDING'

statement ok
SET default_null_order = 'NULLS_FIRST'

statement ok
CREATE TABLE events(
    tenant_id BIGINT,
    event_time TIMESTAMP,
    payload VARCHAR,
    day DATE GENERATED ALWAYS AS (CAST(event_time AS DATE))
) SORTED BY (tenant_id, event_time ASC NULLS LAST)

statement ok
INSERT INTO events(tenant_id, event_time, payload) VALUES
    (2, '2026-01-02', 'b'),
    (1, '2026-01-01', 'a')

query T
SELECT sql FROM duckdb_tables() WHERE table_name = 'events'
----
CREATE TABLE events(tenant_id BIGINT, event_time TIMESTAMP, payload VARCHAR, "day" DATE GENERATED ALWAYS AS(CAST(event_time AS DATE))) SORTED BY (tenant_id ASC NULLS LAST,event_time ASC NULLS LAST);

# Recover the CREATE post-image and initial physical sort state from WAL.
restart

query II
SELECT tenant_id, payload FROM events ORDER BY tenant_id ASC
----
1	a
2	b

query T
SELECT sql FROM duckdb_tables() WHERE table_name = 'events'
----
CREATE TABLE events(tenant_id BIGINT, event_time TIMESTAMP, payload VARCHAR, "day" DATE GENERATED ALWAYS AS(CAST(event_time AS DATE))) SORTED BY (tenant_id ASC NULLS LAST,event_time ASC NULLS LAST);

statement ok
CHECKPOINT

# Recover catalog and physical sort counters from the checkpoint.
restart

query II
SELECT tenant_id, payload FROM events ORDER BY tenant_id ASC
----
1	a
2	b

statement ok
CREATE TABLE ctas_events SORTED BY (tenant_id, event_time) AS
SELECT i % 3 AS tenant_id, TIMESTAMP '2026-01-01' + i * INTERVAL 1 SECOND AS event_time
FROM range(10) t(i)

query T
SELECT sql FROM duckdb_tables() WHERE table_name = 'ctas_events'
----
CREATE TABLE ctas_events(tenant_id BIGINT, event_time TIMESTAMP) SORTED BY (tenant_id ASC NULLS LAST,event_time ASC NULLS LAST);

query III
SELECT count(*), min(tenant_id), max(tenant_id) FROM ctas_events
----
10	0	2

statement error
CREATE TABLE invalid_desc(i INTEGER) SORTED BY (i DESC)
----
<REGEX>:.*SORTED BY only supports ASC sort order.*

statement error
CREATE TABLE invalid_null_order(i INTEGER) SORTED BY (i NULLS FIRST)
----
<REGEX>:.*SORTED BY only supports NULLS LAST.*

statement error
CREATE TABLE invalid_expression(i INTEGER) SORTED BY (i + 1)
----
<REGEX>:.*SORTED BY only supports physical column references.*

statement error
CREATE TABLE invalid_collation(s VARCHAR) SORTED BY (s COLLATE NOCASE)
----
<REGEX>:.*SORTED BY only supports physical column references.*

statement error
CREATE TABLE invalid_qualified(i INTEGER) SORTED BY (invalid_qualified.i)
----
<REGEX>:.*SORTED BY only supports unqualified column references.*

statement error
CREATE TABLE invalid_missing(i INTEGER) SORTED BY (missing)
----
<REGEX>:.*SORTED BY column "missing" does not exist.*

statement error
CREATE TABLE invalid_duplicate(i INTEGER) SORTED BY (i, i)
----
<REGEX>:.*SORTED BY column "i" is specified more than once.*

statement error
CREATE TABLE invalid_generated(i INTEGER, j INTEGER GENERATED ALWAYS AS (i + 1)) SORTED BY (j)
----
<REGEX>:.*SORTED BY column "j" must be a physical column.*

statement error
CREATE TABLE invalid_unique(i INTEGER UNIQUE) SORTED BY (i)
----
<REGEX>:.*SORTED BY tables cannot have PRIMARY KEY, UNIQUE, or FOREIGN KEY constraints.*

statement error
CREATE TABLE invalid_primary(i INTEGER PRIMARY KEY) SORTED BY (i)
----
<REGEX>:.*SORTED BY tables cannot have PRIMARY KEY, UNIQUE, or FOREIGN KEY constraints.*

statement ok
CREATE TABLE parent(i INTEGER PRIMARY KEY)

statement error
CREATE TABLE invalid_foreign(i INTEGER, FOREIGN KEY(i) REFERENCES parent(i)) SORTED BY (i)
----
<REGEX>:.*SORTED BY tables cannot have PRIMARY KEY, UNIQUE, or FOREIGN KEY constraints.*

statement ok
CREATE TABLE checked(i INTEGER NOT NULL CHECK(i > 0)) SORTED BY (i)

statement ok
INSERT INTO checked VALUES (1)

statement error
CREATE INDEX events_idx ON events(tenant_id)
----
<REGEX>:.*Cannot create an index while SORTED BY is enabled.*

statement error
ALTER TABLE events ADD PRIMARY KEY(tenant_id)
----
<REGEX>:.*Cannot add an index constraint while SORTED BY is enabled.*

statement ok
PRAGMA disable_checkpoint_on_shutdown

statement ok
ALTER TABLE events RENAME COLUMN tenant_id TO account_id

# The stable column ID keeps the rule attached to the renamed column during WAL replay.
restart

query T
SELECT sql FROM duckdb_tables() WHERE table_name = 'events'
----
CREATE TABLE events(account_id BIGINT, event_time TIMESTAMP, payload VARCHAR, "day" DATE GENERATED ALWAYS AS(CAST(event_time AS DATE))) SORTED BY (account_id ASC NULLS LAST,event_time ASC NULLS LAST);

statement error
CREATE OR REPLACE TABLE events(i INTEGER)
----
<REGEX>:.*CREATE OR REPLACE is not supported for tables with SORTED BY history.*

statement error
CREATE TEMP TABLE invalid_temp(i INTEGER) SORTED BY (i)
----
<REGEX>:.*SORTED BY is only supported for persistent DuckDB tables.*

statement ok
ATTACH '{TEST_DIR}/create_table_sorted_by_old.db' AS old (STORAGE_VERSION 'v1.5.0')

statement error
CREATE TABLE old.invalid_version(i INTEGER) SORTED BY (i)
----
<REGEX>:.*SORTED BY requires storage version v2.0.0 or newer.*

statement ok
DETACH old
